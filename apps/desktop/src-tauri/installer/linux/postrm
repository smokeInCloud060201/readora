#!/bin/sh
# Readora Debian/Ubuntu post-removal script (Debian Policy §6.5)
# Removes ONLY Readora's own SQLite database, staged library/update files, and cache artifacts
# strictly on `purge` (NEVER on `remove` or `upgrade`), refusing symlinked path segments and
# enforcing fail-closed privilege drop to the target non-root user (never running as uid 0).
set -eu

case "${1:-}" in
  purge)
    TARGET_USER="${SUDO_USER:-}"
    case "$TARGET_USER" in
      ""|root|*[!a-zA-Z0-9._-]*)
        exit 0
        ;;
    esac

    check_no_symlink_segments() {
      target_path="$1"
      cur=""
      old_ifs="$IFS"
      IFS="/"
      # shellcheck disable=SC2086
      set -- $target_path
      IFS="$old_ifs"
      for seg in "$@"; do
        [ -n "$seg" ] || continue
        cur="$cur/$seg"
        if [ -L "$cur" ]; then
          return 1
        fi
      done
      return 0
    }

    RUNUSER_BIN=""
    if command -v runuser >/dev/null 2>&1; then
      RUNUSER_BIN=$(command -v runuser)
    elif [ -x /usr/sbin/runuser ]; then
      RUNUSER_BIN="/usr/sbin/runuser"
    elif [ -x /sbin/runuser ]; then
      RUNUSER_BIN="/sbin/runuser"
    fi

    SU_BIN=""
    if [ -z "$RUNUSER_BIN" ]; then
      if command -v su >/dev/null 2>&1; then
        SU_BIN=$(command -v su)
      elif [ -x /bin/su ]; then
        SU_BIN="/bin/su"
      elif [ -x /usr/bin/su ]; then
        SU_BIN="/usr/bin/su"
      fi
    fi

    CLEANUP_SCRIPT='
      set -eu
      USER_HOME="$1"
      DATA_DIR="$USER_HOME/.local/share/readora"
      CACHE_DIR="$USER_HOME/.cache/readora"

      is_safe_dir() {
        [ -d "$1" ] && [ ! -L "$1" ]
      }

      for d in "$DATA_DIR" "$CACHE_DIR"; do
        if [ -d "$d/updates" ] && [ ! -L "$d/updates" ]; then
          find -P "$d/updates" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
          rmdir "$d/updates" 2>/dev/null || true
        fi
      done

      if is_safe_dir "$DATA_DIR"; then
        find -P "$DATA_DIR" -maxdepth 1 -type f \( \
          -name "readora.sqlite" \
          -o -name "readora.sqlite-wal" \
          -o -name "readora.sqlite-shm" \
          -o -name "readora.sqlite-journal" \
          -o -name ".*.tmp-*" \
        \) -delete 2>/dev/null || true

        if is_safe_dir "$DATA_DIR/library"; then
          if is_safe_dir "$DATA_DIR/library/pdfs"; then
            find -P "$DATA_DIR/library/pdfs" -maxdepth 2 -type f \( \
              -name "*.pdf" \
              -o -name "*.pdf.tmp" \
              -o -name ".*.tmp-*" \
            \) -delete 2>/dev/null || true
            find -P "$DATA_DIR/library/pdfs" -mindepth 1 -maxdepth 1 -type d \
              -exec rmdir {} + 2>/dev/null || true
            rmdir "$DATA_DIR/library/pdfs" 2>/dev/null || true
          fi
          find -P "$DATA_DIR/library" -maxdepth 1 -type f \( \
            -name "state.json" \
            -o -name "state.json.tmp*" \
            -o -name ".*.tmp-*" \
          \) -delete 2>/dev/null || true
          rmdir "$DATA_DIR/library" 2>/dev/null || true
        fi

        if is_safe_dir "$DATA_DIR/cache"; then
          find -P "$DATA_DIR/cache" -maxdepth 1 -type f \( \
            -name "*.png" \
            -o -name "*.cache" \
            -o -name "*.tmp" \
            -o -name "*.json" \
            -o -name "*.bin" \
          \) -delete 2>/dev/null || true
          rmdir "$DATA_DIR/cache" 2>/dev/null || true
        fi

        rmdir "$DATA_DIR" 2>/dev/null || true
      fi

      if is_safe_dir "$CACHE_DIR"; then
        if is_safe_dir "$CACHE_DIR/render-cache"; then
          find -P "$CACHE_DIR/render-cache" -maxdepth 1 -type f \( \
            -name "*.png" \
            -o -name "*.cache" \
            -o -name "*.bin" \
          \) -delete 2>/dev/null || true
          rmdir "$CACHE_DIR/render-cache" 2>/dev/null || true
        fi
        find -P "$CACHE_DIR" -maxdepth 1 -type f \( \
          -name "*.png" \
          -o -name "*.cache" \
          -o -name "*.tmp" \
          -o -name "*.json" \
          -o -name "*.bin" \
        \) -delete 2>/dev/null || true
        rmdir "$CACHE_DIR" 2>/dev/null || true
      fi
    '

    for user in "$TARGET_USER"; do
      home=$(getent passwd "$user" | cut -d: -f6 2>/dev/null || true)
      case "$home" in
        /*) ;;
        *) continue ;;
      esac

      if [ ! -d "$home" ] || [ -L "$home" ]; then
        continue
      fi

      DATA_DIR="$home/.local/share/readora"
      CACHE_DIR="$home/.cache/readora"

      if ! check_no_symlink_segments "$DATA_DIR" || ! check_no_symlink_segments "$CACHE_DIR"; then
        continue
      fi

      if [ "$(id -u)" -eq 0 ]; then
        if [ -n "$RUNUSER_BIN" ]; then
          "$RUNUSER_BIN" -u "$user" -- /bin/sh -c "$CLEANUP_SCRIPT" -- "$home" || true
        elif [ -n "$SU_BIN" ]; then
          "$SU_BIN" -s /bin/sh "$user" -c '/bin/sh -c "$1" -- "$2"' -- "$CLEANUP_SCRIPT" "$home" || true
        else
          # Fail-closed: NEVER execute cleanup / rm -rf inside a user home directory as uid 0.
          continue
        fi
      else
        /bin/sh -c "$CLEANUP_SCRIPT" -- "$home" || true
      fi
    done
    ;;

  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

exit 0
